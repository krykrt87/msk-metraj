{
  "name": "msk-metraj",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --mode yerel",
    "dev:emu": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project unit",
    "test:emu": "node scripts/emulators.mjs exec \"npx vitest run --project emu\"",
    "emulators": "node scripts/emulators.mjs start",
    "build:functions": "node scripts/build-functions.mjs",
    "import": "tsx scripts/import-excel.ts",
    "seed:import": "node scripts/emulators.mjs seed \"npx tsx scripts/import-excel.ts --reset\"",
    "admin": "tsx scripts/bootstrap-admin.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "exceljs": "^4.4.0",
    "firebase": "^13.4.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.2",
    "three": "^0.187.0",
    "zod": "^4.6.7"
  },
  "overrides": {
    "@types/node": "$@types/node"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@napi-rs/canvas": "^1.2.0",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.3.0",
    "dxf-parser": "^1.1.2",
    "esbuild": "^0.28.2",
    "firebase-admin": "^14.5.1",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.37.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
