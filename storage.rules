rules_version = '2';
// Paftalar yalnız kurallardan geçen okumayla (getBytes) alınır; token'lı indirme adresi kullanılmaz.
// Yetki her istekte kullanıcı dokümanından okunur: erişim kaldırılınca hemen geçerli olur.
service firebase.storage {
  match /b/{bucket}/o {
    function userPath() { return /databases/(default)/documents/users/$(request.auth.uid); }
    function profile() { return firestore.get(userPath()).data; }
    function active() { return request.auth != null && firestore.exists(userPath()) && profile().active == true; }
    function acc(p, d) { return profile().access.get(p, {}).get(d, {}); }

    match /projects/{p}/disciplines/{d}/drawings/{code}/{file} {
      allow read: if active() && acc(p, d).get('view', false) == true && acc(p, d).get('drawings', false) == true;
      allow create, update: if active() && profile().role == 'admin'
        && request.resource.contentType == 'application/pdf'
        && request.resource.size < 100 * 1024 * 1024;
      allow delete: if false;
    }
    // 3B model: metraj aktarımıyla (yönetici SDK) yazılır; görüntüleme yetkisi olan okur
    match /projects/{p}/disciplines/{d}/model/{file} {
      allow read: if active() && acc(p, d).get('view', false) == true;
      allow write: if false;
    }
  }
}
