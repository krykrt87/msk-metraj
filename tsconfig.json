{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": false,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": ["node", "vite/client"],
    "paths": { "@shared/*": ["./shared/*"] }
  },
  "include": ["shared", "web/src", "web/test-setup.ts", "functions/src", "scripts", "tests", "vite.config.ts", "vitest.config.ts"]
}
